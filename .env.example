# Copy to .env for local use. These are the only application environment settings.
# Keep the API key server-side. Other runtime defaults live in analyst/config.py.
# The application currently permits gpt-6-luna only, with no alternate-model fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Fast mode requests service_tier=fast at twice Luna's Standard token rates.
OPENAI_FAST_MODE=true
